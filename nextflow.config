
// Timestamp evaluated once at launch, e.g. 2026-08-11_14-32-05
def run_timestamp = new java.text.SimpleDateFormat("yyyy-MM-dd_HH-mm-ss").format(new Date())

// Resolve the run folder name.
//   - If --run_name is given, use it verbatim (stable across -resume).
//   - Otherwise use a fresh launch timestamp (unique per run).
// This lets `-resume` reuse the same outdir: just pass the same --run_name.
def resolved_run_name = params.run_name ? "${params.run_name}" : "run_${run_timestamp}"

params {
    // Input options
    input                      = null   // samplesheet CSV

    // Output directory control.
    //   outdir_base : parent directory for runs (default ./results)
    //   run_name    : stable subfolder name; set this to make -resume reuse
    //                 the same outdir. If null, a timestamp is used instead.
    //   outdir      : final resolved output path. Set this directly to pin an
    //                 exact directory and bypass base+run_name entirely.
    outdir_base                = './results'
    run_name                   = null
    outdir                     = "${params.outdir_base ?: './results'}/${resolved_run_name}"

    // Primer panel for the amplicon simulation (cutadapt).
    // FASTA of primer sequences OR a two-column TSV of fwd/rev primers.
    primer_fasta               = null

    // cutadapt options
    cutadapt_error_rate        = 0.1
    cutadapt_min_overlap       = 10
    cutadapt_min_len           = 50

    // SeqSero2 options
    // -m: workflow mode. 'a' = allele microassembly (recommended for reads),
    //     'k' = k-mer (fast). We use 'a' for reads, 'k' for assemblies.
    seqsero2_reads_mode        = 'a'
    seqsero2_reads_datatype    = '2'    // '2' = separated paired-end reads
    seqsero2_sim_datatype      = '4'    // '4' = single-end / generic reads

    // MultiQC
    multiqc_title              = null
    multiqc_config             = "${projectDir}/assets/multiqc_config.yml"

    // Boilerplate
    publish_dir_mode           = 'copy'
    max_memory                 = '128.GB'
    max_cpus                   = 16
    max_time                   = '240.h'
}

profiles {
    docker      { docker.enabled      = true  }
    singularity { singularity.enabled = true  }
    conda       { conda.enabled       = true  }
    test        { includeConfig 'conf/test.config' }
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

manifest {
    name            = 'seqsero-compare'
    author          = 'Generated pipeline'
    description     = 'Compare SeqSero2 Salmonella serotype calls across amplicon, assembly, and simulated-amplicon sources'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}
