/*
 * Smoke-test profile: runs the full pipeline end-to-end on a tiny bundled
 * dataset with minimal resources. Use with:
 *
 *   nextflow run main.nf -profile test,docker
 *
 * The test assets live under assets/test_data/ and are shipped with the repo
 * so no network download is required.
 */
params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal end-to-end test dataset'

    // Cap resources so this runs on a laptop / CI runner.
    max_cpus                   = 2
    max_memory                 = '6.GB'
    max_time                   = '1.h'

    // Stable run name so repeated CI runs / -resume reuse one folder.
    outdir_base                = './results'
    run_name                   = 'test'

    // Bundled inputs.
    input                      = "${projectDir}/assets/test_data/samplesheet_test.csv"
    primer_fasta               = "${projectDir}/assets/test_data/primers_test.tsv"

    // k-mer mode is fastest for the tiny test inputs.
    seqsero2_reads_mode        = 'k'
    seqsero2_reads_datatype    = '2'

    multiqc_title              = 'SeqSero2 Comparison — Test Run'
}

// Keep per-process requests within the test caps.
process {
    withLabel:process_low    { cpus = 1; memory = 2.GB; time = 30.min }
    withLabel:process_medium { cpus = 2; memory = 4.GB; time = 45.min }
    withLabel:process_high   { cpus = 2; memory = 6.GB; time = 1.h    }
}